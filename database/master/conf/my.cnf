[mysqld]
server-id = 1
log-bin = mysql-bin
binlog_format = ROW
binlog_do_db = auth_db
binlog_do_db = catalogo_db
binlog_do_db = pedidos_db
binlog_do_db = pagos_db

character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Hardening interno de MariaDB
skip-name-resolve
max_connections = 150
connect_timeout = 10
wait_timeout = 600
interactive_timeout = 600

# Logging de seguridad
log_warnings = 2
general_log = 0
slow_query_log = 1
long_query_time = 2
