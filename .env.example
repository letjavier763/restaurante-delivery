# Entorno
APP_ENV=production
APP_NAME="TechNova Electronics & Technology"
APP_URL=http://localhost

# Puertos expuestos al host (Solo Gateway/Nginx tiene puertos públicos)
GATEWAY_PORT=80
GATEWAY_SSL_PORT=443

# Claves Criptográficas (OWASP A02 & Zero Trust)
JWT_SECRET=c8f8b5f939e08328dc4391ef417f7d1b33e5ca8db954203d9803bf5fcf216a75
JWT_EXPIRATION_SECONDS=3600
JWT_ISSUER=technova-auth-service

# MariaDB Master (Escrituras) - ¡NO expuesto al exterior por Docker Hardening!
DB_MASTER_HOST=mariadb-master
DB_MASTER_PORT=3306
DB_ROOT_PASSWORD=MasterSecPass_2026_TechNova!
DB_USER=technova_app
DB_PASSWORD=AppMasterPass_2026!
DB_REPL_USER=replicator
DB_REPL_PASSWORD=ReplicationPass_2026!

# MariaDB Slave (Lecturas) - ¡NO expuesto al exterior por Docker Hardening!
DB_SLAVE_HOST=mariadb-slave
DB_SLAVE_PORT=3306
DB_SLAVE_ROOT_PASSWORD=SlaveSecPass_2026_TechNova!

# Nombres de Bases de Datos de Negocio
DB_AUTH_NAME=auth_db
DB_CATALOGO_NAME=catalogo_db
DB_PEDIDOS_NAME=pedidos_db
DB_PAGOS_NAME=pagos_db

# MariaDB Audit DB (Microservicio Dedicado en Volumen Separado)
DB_AUDIT_HOST=mariadb-audit
DB_AUDIT_PORT=3306
DB_AUDIT_NAME=audit_db
DB_AUDIT_ROOT_PASSWORD=AuditSecPass_2026_TechNova!
